#!/bin/sh
set -eu

src_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build_dir="$src_dir/build"
extra_args=""

while [ $# -gt 0 ]; do
    case "$1" in
        --build-dir=*)
            build_dir=${1#--build-dir=}
            shift
            ;;
        --build-dir)
            build_dir=$2
            shift 2
            ;;
        *)
            extra_args="$extra_args $1"
            shift
            ;;
    esac
done

# shellcheck disable=SC2086
cmake -S "$src_dir" -B "$build_dir" $extra_args
